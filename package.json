{
  "name": "magic",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal agent-native browser shell",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:agent": "node scripts/build-agent.mjs",
    "dist": "npm run build && npm run build:agent && electron-builder --publish never",
    "dist:mac": "npm run build && npm run build:agent && electron-builder --mac --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "agent:dev": "eve dev",
    "agent:info": "eve info",
    "agent:build": "eve build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.84",
    "ai": "^7.0.162",
    "eve": "^1.0.0-rc.2",
    "gsap": "^3.15.0",
    "preact": "^11.1.0",
    "zod": "^4.6.7"
  },
  "author": {
    "name": "Magic contributors"
  },
  "homepage": "https://github.com/michaelzoub/magic"
}
